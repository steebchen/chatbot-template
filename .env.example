# PLOY_AI_URL and PLOY_AI_TOKEN are injected automatically by Ploy (`ai: true`
# in ploy.yaml), both in deployments and when running `ploy dev`. Only set them
# by hand if you run plain `next dev` (`pnpm dev:next`).
# PLOY_AI_URL=
# PLOY_AI_TOKEN=

# Optional: enables the web_search tool.
# TAVILY_API_KEY=
